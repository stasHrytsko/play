#!/bin/sh
# Правило №1 (CLAUDE.md): доска не отстаёт от репозитория.
#
# Стадии считаются из файлов, поэтому забыть можно только пересчитать снимок.
# Этот хук пересчитывает его сам и кладёт в тот же коммит.
#
# Включается один раз на машине:
#   git config core.hooksPath .githooks

set -e

root=$(git rev-parse --show-toplevel)
cd "$root"

# Хук не должен мешать коммитить там, где node недоступен: CI всё равно
# проверит (node pipeline.mjs --check) и скажет об этом внятно.
command -v node >/dev/null 2>&1 || exit 0
[ -f pipeline.mjs ] || exit 0

node pipeline.mjs --write >/dev/null

if ! git diff --quiet -- dashboard/status.json; then
  git add dashboard/status.json
  echo "pre-commit: доска обновлена (dashboard/status.json добавлен в коммит)"
fi
